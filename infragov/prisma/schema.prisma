generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  roleId       String
  departmentId String?
  divisionId   String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role      @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  division   Division?   @relation(fields: [divisionId], references: [id])

  responsibleAssets Asset[]           @relation("ResponsibleUser")
  inspections       Inspection[]      @relation("Inspector")
  createdWorkOrders WorkOrder[]       @relation("CreatedBy")
  assignedWorkOrders WorkOrder[]      @relation("AssignedTo")
  resolvedAlerts    Alert[]           @relation("ResolvedBy")
  notifications     Notification[]
  auditLogs         AuditLog[]        @relation("PerformedBy")
  uploadedDocuments Document[]        @relation("UploadedBy")
  lifecycleEvents   LifecycleEvent[]  @relation("PerformedBy")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  divisions Division[]
  assets    Asset[]
  users     User[]
}

model Division {
  id           String   @id @default(uuid())
  departmentId String
  name         String
  code         String   @unique
  description  String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  assets     Asset[]
  users      User[]
}

model AssetCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  icon        String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assetTypes AssetType[]
  assets     Asset[]
}

model AssetType {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  code        String   @unique
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  AssetCategory  @relation(fields: [categoryId], references: [id])
  templates AssetTemplate[]
  assets    Asset[]
}

model AssetTemplate {
  id          String   @id @default(uuid())
  assetTypeId String
  name        String
  description String?
  schemaJson  String   // JSON string for dynamic fields
  version     Int      @default(1)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assetType AssetType @relation(fields: [assetTypeId], references: [id])
}

model Location {
  id        String   @id @default(uuid())
  address   String?
  state     String?
  district  String?
  city      String?
  zone      String?
  ward      String?
  locality  String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]
}

model Vendor {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assets Asset[]
}

model Asset {
  id                    String   @id @default(uuid())
  assetCode             String   @unique
  name                  String
  categoryId            String
  assetTypeId           String
  departmentId          String
  divisionId            String?
  responsibleUserId     String?
  locationId            String?
  vendorId              String?

  lifecycleStatus       String   @default("OPERATIONAL")
  operationalStatus     String   @default("ACTIVE")

  conditionScore        Int      @default(100)
  conditionLabel        String   @default("Excellent")

  criticality           String   @default("MEDIUM")
  riskScore             Int      @default(0)
  riskLabel             String   @default("Low")

  installationDate      DateTime?
  commissioningDate     DateTime?
  expectedLifeYears     Int?
  purchaseCost          Float?

  manufacturer          String?
  model                 String?
  serialNumber          String?
  description           String?
  technicalMetadataJson String?  // JSON string

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  retiredAt             DateTime?

  category        AssetCategory   @relation(fields: [categoryId], references: [id])
  assetType       AssetType       @relation(fields: [assetTypeId], references: [id])
  department      Department      @relation(fields: [departmentId], references: [id])
  division        Division?       @relation(fields: [divisionId], references: [id])
  responsibleUser User?           @relation("ResponsibleUser", fields: [responsibleUserId], references: [id])
  location        Location?       @relation(fields: [locationId], references: [id])
  vendor          Vendor?         @relation(fields: [vendorId], references: [id])

  inspections      Inspection[]
  workOrders       WorkOrder[]
  maintenanceRecords MaintenanceRecord[]
  lifecycleEvents  LifecycleEvent[]
  policies         Policy[]
  documents        Document[]
  alerts           Alert[]
}

model Inspection {
  id                       String   @id @default(uuid())
  assetId                  String
  inspectorId              String
  scheduledDate            DateTime?
  inspectionDate           DateTime
  status                   String   @default("COMPLETED")

  physicalConditionScore   Int
  operationalConditionScore Int
  safetyScore              Int
  overallScore             Int

  observations             String?
  recommendation           String?
  photoUrl                 String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  asset     Asset @relation(fields: [assetId], references: [id])
  inspector User  @relation("Inspector", fields: [inspectorId], references: [id])
}

model WorkOrder {
  id              String   @id @default(uuid())
  workOrderNumber String   @unique
  assetId         String
  createdById     String
  assignedToId    String?

  issue           String
  description     String?
  priority        String   @default("MEDIUM")
  status          String   @default("OPEN")

  dueDate         DateTime?
  startedAt       DateTime?
  completedAt     DateTime?

  estimatedCost   Float?
  actualCost      Float?
  completionNotes String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset      Asset @relation(fields: [assetId], references: [id])
  createdBy  User  @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo User? @relation("AssignedTo", fields: [assignedToId], references: [id])

  maintenanceRecords MaintenanceRecord[]
}

model MaintenanceRecord {
  id              String   @id @default(uuid())
  assetId         String
  workOrderId     String?
  maintenanceType String
  maintenanceDate DateTime
  performedBy     String?
  cost            Float?
  description     String?
  result          String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset     Asset      @relation(fields: [assetId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])
}

model LifecycleEvent {
  id           String   @id @default(uuid())
  assetId      String
  eventType    String
  eventDate    DateTime
  performedById String?
  oldStatus    String?
  newStatus    String?
  description  String?
  cost         Float?
  notes        String?
  createdAt    DateTime @default(now())

  asset       Asset @relation(fields: [assetId], references: [id])
  performedBy User? @relation("PerformedBy", fields: [performedById], references: [id])
}

model Policy {
  id                String   @id @default(uuid())
  assetId           String
  policyType        String
  provider          String?
  startDate         DateTime?
  endDate           DateTime?
  frequencyDays     Int?
  coverage          String?
  slaResponseHours  Int?
  slaResolutionHours Int?
  status            String   @default("ACTIVE")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id])
}

model Document {
  id           String   @id @default(uuid())
  assetId      String
  documentType String
  fileName     String
  fileUrl      String
  uploadedById String?
  uploadedAt   DateTime @default(now())

  asset      Asset @relation(fields: [assetId], references: [id])
  uploadedBy User? @relation("UploadedBy", fields: [uploadedById], references: [id])
}

model Alert {
  id           String   @id @default(uuid())
  assetId      String?
  alertType    String
  severity     String
  title        String
  description  String?
  dueDate      DateTime?
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  asset      Asset? @relation(fields: [assetId], references: [id])
  resolvedBy User?  @relation("ResolvedBy", fields: [resolvedById], references: [id])

  notifications Notification[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  alertId   String?
  type      String
  title     String
  message   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  alert Alert? @relation(fields: [alertId], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  oldValuesJson String?
  newValuesJson String?
  performedById String?
  reason        String?
  timestamp     DateTime @default(now())

  performedBy User? @relation("PerformedBy", fields: [performedById], references: [id])
}
